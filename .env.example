# Local OCR is the default; alternatives are route_llm and disabled.
IMAGE_EXTRACTION_PROVIDER=local
# Set this if tesseract is not on PATH or in the standard Windows location.
TESSERACT_CMD=
LOCAL_OCR_TIMEOUT_SECONDS=60

# Optional Route-LLM multimodal grid extraction. Used only for route_llm.
# Use HTTPS except for a local development endpoint.
ROUTE_LLM_BASE_URL=
ROUTE_LLM_API_KEY=
ROUTE_LLM_MODEL=
ROUTE_LLM_TIMEOUT_SECONDS=30

# Upload and extraction limits.
IMAGE_MAX_BYTES=5242880
IMAGE_MAX_WIDTH=4096
IMAGE_MAX_HEIGHT=4096
EXTRACTION_CONFIDENCE_THRESHOLD=0.7
